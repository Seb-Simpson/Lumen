# Leave DATABASE_URL unset for persistent embedded PostgreSQL in .data/postgres (development).
# Set a standard PostgreSQL connection for production. Never commit real credentials.
# DATABASE_URL=postgresql://lumen:password@localhost:5432/lumen
BETTER_AUTH_URL=http://localhost:3000
# Set a unique random secret of at least 32 characters in production.
# BETTER_AUTH_SECRET=
# Development email is written to .data/mail/*.json; open the url in that JSON.
# Production email requires both variables below (Resend HTTP API).
# RESEND_API_KEY=
# EMAIL_FROM=Lumen <hello@your-verified-domain.example>
# Optional isolated storage folder (also used by integration tests)
# LUMEN_DATA_DIR=.data
# Administrator-approved public Spotify show/episode links (comma separated).
# Empty by default: no invented podcast catalogue is seeded.
# SPOTIFY_APPROVED_URLS=
